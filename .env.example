PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/motoparts_nepal?replicaSet=rs0
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
# Set to 1 only when running behind one trusted reverse proxy.
TRUST_PROXY=0
# eSewa sandbox: obtain the current sandbox signing key from the official docs.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Optional delivery confirmations; blank credentials disable sending.
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
# Local demo accounts only, created by npm run seed:wallets.
DEMO_WALLET_PASSWORD=DemoWallet123!
# Lab 7: local measurement works without a Meta account; nothing is sent to Meta.
MARKETING_ENABLED=true
META_PIXEL_ENABLED=false
META_PIXEL_ID=
# Demo dashboard shows only the current session's events. Disable on production.
LAB7_DASHBOARD_ENABLED=true
# Lab 8: use your deployed public origin in APP_BASE_URL for SEO URLs.
SITE_INDEXING_ENABLED=true
# Google Analytics 4 stays disconnected until you add your own Measurement ID.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
# Enable only while verifying events in GA4 DebugView.
GA4_DEBUG_MODE=false
