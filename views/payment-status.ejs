<%- include('partials/header') %>
<main class="container">
  <div class="status-shell">
    <% if (order.paymentStatus === 'paid') { %>
      <div class="status-icon ok">&#10003;</div>
      <h1>Payment successful</h1>
      <% if (order.fulfillmentStatus === 'stock_review') { %>
        <p>Payment received. Some items sold out during payment; please contact the store to arrange fulfillment or a refund.</p>
      <% } else { %>
        <p>Thank you, <%= order.customer.fullName %> — your order has been placed.</p>
      <% } %>
    <% } else if (order.paymentMethod === 'cod') { %>
      <div class="status-icon ok">&#10003;</div>
      <h1>Order confirmed</h1>
      <p>Thank you, <%= order.customer.fullName %>. Your items are reserved. Pay Rs. <%= order.total.toLocaleString('en-IN') %> when your order is delivered.</p>
    <% } else { %>
      <div class="status-icon fail">&#10007;</div>
      <h1><%= order.paymentStatus === 'pending' ? 'Payment pending' : 'Payment failed' %></h1>
      <p><%= order.paymentStatus === 'pending' ? 'Payment has not been confirmed. Check your gateway account before retrying.' : 'Your payment attempt failed. You can try again.' %></p>
      <a href="/payment/<%= order.paymentMethod %>/<%= order._id %>" class="btn btn-primary">Retry payment</a>
    <% } %>
    <div class="receipt">
      <div class="row"><span>Order ID</span><span><%= order._id %></span></div>
      <div class="row"><span>Payment method</span><span><%= order.paymentMethod === 'esewa' ? 'eSewa' : order.paymentMethod === 'cod' ? 'Cash on delivery' : 'Card' %></span></div>
      <div class="row"><span>Payment status</span><span><%= order.paymentStatus === 'paid' ? 'Paid' : order.paymentMethod === 'cod' ? 'Due on delivery' : order.paymentStatus === 'pending' ? 'Awaiting confirmation' : 'Failed' %></span></div>
      <% if (order.transactionId) { %><div class="row"><span>Transaction ID</span><span><%= order.transactionId %></span></div><% } %>
      <% if (order.cardLast4) { %><div class="row"><span>Card</span><span>**** **** **** <%= order.cardLast4 %></span></div><% } %>
      <div class="row"><span>Delivery to</span><span><%= order.customer.address %>, <%= order.customer.city %></span></div>
      <div class="row"><span>Total</span><span>Rs. <%= order.total.toLocaleString('en-IN') %></span></div>
    </div>
  </div>
  <p style="margin-top:24px;"><a href="/" class="btn btn-outline">Continue shopping</a></p>
</main>
<%- include('partials/footer') %>
