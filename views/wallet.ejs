<%- include('partials/header') %>
<div class="container">
  <h1>My Wallet</h1>
  <p><%= wallet.ownerName %> (<%= wallet.email %>)</p>
  <div class="amount-display">
    <div class="amt">Rs. <%= wallet.balance.toLocaleString('en-IN') %></div>
    <div class="label">Available Balance</div>
  </div>


  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px;">
    <div class="form-card">
      <h3 style="font-size:1rem;">Top Up Wallet</h3>
      <form action="/wallet/topup/esewa/start" method="POST" style="margin-top:10px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row">
    <label for="esewaAmount">top up with eSewa (NPR)</label>
    <input type="number" id="esewaAmount" name="amount" min="1" step="1" required>
  </div>
  <button class="btn btn-esewa btn-block" type="submit">Top Up with eSewa</button>
</form>
    </div>

    <div class="form-card">
      <h3 style="font-size:1rem;">Send Money</h3>
      <form action="/wallet/transfer" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <label for="toWalletId">Send to</label>
          <select name="toWalletId" required>
            <% otherWallets.forEach(function(w) { %>
              <option value="<%= w._id %>"><%= w.ownerName %> (<%= w.email %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <label for="amount">Amount (NPR)</label>
          <input type="number" name="amount" min="1" step="1" required>
        </div>
        <div class="form-row">
          <label for="note">Note (optional)</label>
          <input type="text" name="note" placeholder="e.g. for helmet repair">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Send</button>
      </form>
    </div>
  </div>

  <h3 style="margin-top:32px;">Recent Transactions</h3>
  <table class="cart-table">
    <thead><tr><th>Date</th><th>Type</th><th>Detail</th><th>Status</th><th>Amount</th></tr></thead>
    <tbody>
      <% transactions.forEach(function(t) { %>
        <tr>
          <td><%= t.createdAt.toLocaleString() %></td>
          <td><%= t.type === 'topup' ? 'Top-up' : 'Transfer' %></td>
          <td>
            <% if (t.type === 'topup') { %>
              <%= t.status === 'completed' ? 'Added to wallet' : 'Top-up awaiting confirmation' %>
            <% } else if (String(t.fromWallet._id) === String(wallet._id)) { %>
              Sent to <%= t.toWallet.ownerName %>
            <% } else { %>
              Received from <%= t.fromWallet.ownerName %>
            <% } %>
          </td>
          <td><%= t.status %></td>
          <td>
            <% if (t.type === 'transfer' && String(t.fromWallet._id) === String(wallet._id)) { %>
              - Rs. <%= t.amount %>
            <% } else { %>
              <%= t.status === 'completed' ? '+' : 'Pending' %> Rs. <%= t.amount %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>