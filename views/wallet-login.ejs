<%- include('partials/header') %>
<div class="container">
  <div class="form-card">
    <h3>Choose a demo wallet account</h3>
    <p>Pick an account to simulate being logged in (no password needed for this lab demo).</p>
    <form action="/wallet/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <label for="walletId">Account</label>
        <select id="walletId" name="walletId" required>
          <% wallets.forEach(function(w) { %>
            <option value="<%= w._id %>"><%= w.ownerName %> (<%= w.email %>) — Rs. <%= w.balance %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Continue</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>