<%- include('partials/header') %>

<div class="container">
  <div class="gateway-shell">
    <div class="gateway-header">
      <div class="logo">eSewa</div>
      <div style="font-size:0.75rem;">SIMULATED</div>
    </div>
    <div class="gateway-body">
      

      <div class="amount-display">
        <div class="amt">Rs. <%= order.total.toLocaleString('en-IN') %></div>
        <div class="label">Amount payable to MotoParts Nepal</div>
      </div>

      <form action="/payment/esewa/<%= order._id %>/login" method="POST">
        <div class="form-row">
          <label for="esewaId">eSewa ID (mobile number)</label>
          <input type="text" id="esewaId" name="esewaId" placeholder="98XXXXXXXX" required>
        </div>
        <div class="form-row">
          <label for="password">eSewa Password</label>
          <input type="password" id="password" name="password" placeholder="Enter any password" required>
        </div>
        <button type="submit" class="btn btn-esewa btn-block">Log in &amp; Continue</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
