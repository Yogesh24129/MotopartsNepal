<%- include("header") %><div class="heading"><div><p class="eyebrow">ORDER DETAILS</p><h1>Order #<%= order._id.toString().slice(-6).toUpperCase() %></h1><p class="muted"><%= date(order.createdAt) %> · <%= order.paymentEnvironment %> payment environment</p></div><a href="/admin/orders">← Orders</a></div>
<div class="columns"><section class="panel"><h2>Delivery details</h2><p><strong><%= order.customer.fullName %></strong><br><%= order.customer.phone %><br><%= order.customer.email || '' %></p><p><%= order.customer.address %><br><%= order.customer.city %></p><p class="badge"><%= order.paymentMethod %> · <%= order.paymentStatus %></p><p>Stock: <strong><%= order.fulfillmentStatus %></strong></p><p>Shipment: <strong><%= order.shippingStatus || 'processing' %></strong></p></section><section class="panel"><h2>Items & payment</h2><table><thead><tr><th>Product</th><th>Quantity</th><th>Value</th></tr></thead><tbody><% order.items.forEach(item=>{ %><tr><td><%= item.name %></td><td><%= item.quantity %></td><td><%= npr(item.price*item.quantity) %></td></tr><% }) %></tbody></table><div class="metric-line"><span>Delivery fee</span><strong><%= npr(order.shippingFee) %></strong></div><div class="metric-line"><span>Total</span><strong><%= npr(order.total) %></strong></div></section></div>
<section class="panel"><h2>Finalize & manage shipment</h2><p class="muted">Assign a shipping partner, finalize the order, then prepare email and WhatsApp notices below.</p><p><%= order.finalizedAt ? "Finalized: " + date(order.finalizedAt) : "Awaiting finalization" %></p><form action="/admin/orders/<%= order._id %>" method="POST" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= order.updatedAt.toISOString() %>">
<label>Shipping partner<select name="partner"><option value="">Keep current assignment</option><% partners.forEach(partner=>{ %><option value="<%= partner._id %>" <%= order.shippingPartner && String(order.shippingPartner._id)===String(partner._id)?'selected':'' %>><%= partner.name %></option><% }) %></select><small>Current: <%= order.shippingPartner ? order.shippingPartner.name : 'Unassigned' %></small></label>
<label>Shipment status<select name="status"><% ["processing","dispatched","delivered","cancelled"].forEach(status=>{ %><option <%= (order.shippingStatus || 'processing')===status?'selected':'' %>><%= status %></option><% }) %></select></label><div class="wide"><button name="action" value="update">Save shipment</button> <% if((order.shippingStatus || "processing")==="processing"){ %><button name="action" value="finalize">Finalize order</button><% } %> <% if(order.paymentStatus==="paid" && order.fulfillmentStatus==="stock_review" && order.shippingStatus!=="cancelled"){ %><button name="action" value="allocate" class="secondary">Reserve stock after review</button><% } %> <% if(order.shippingStatus==='delivered' && order.paymentMethod==='cod' && order.paymentStatus!=='paid'){ %><button name="action" value="paid" class="secondary">Record COD collected</button><% } %> <% if((order.shippingStatus || 'processing')==='processing' && order.paymentStatus!=='paid'){ %><button name="action" value="cancel" class="danger">Cancel order & release stock</button><% } %></div></form><p class="muted">Dispatch requires reserved stock, an assigned partner, and confirmed payment or COD. Paid cancellations require a payment-provider refund.</p></section>
<section class="panel"><h2>Notify shipping partner</h2><p class="muted">Finalize the order first. Preview the recipient and delivery text, then send email or open WhatsApp.</p><form action="/admin/orders/<%= order._id %>/notices/preview" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="channel" aria-label="Notice channel"><option value="email">Email <%= configured('email')?'':'(provider setup needed)' %></option><option value="whatsapp">WhatsApp (opens a prefilled chat)</option></select><button>Preview notice</button></form><table><thead><tr><th>Channel</th><th>Recipient</th><th>Status</th><th>Created</th></tr></thead><tbody><% notices.forEach(notice=>{ %><tr><td><a href="/admin/notices/<%= notice._id %>"><%= notice.channel %></a></td><td><%= notice.recipient %></td><td><%= notice.status %></td><td><%= date(notice.createdAt) %></td></tr><% }) %></tbody></table></section><%- include("footer") %>
