<%- include("header") %><div class="heading"><div><p class="eyebrow">CATALOG MANAGEMENT</p><h1><%= product ? 'Edit product' : 'Add product' %></h1></div><a href="/admin/products">← Products</a></div>
<section class="panel"><form action="<%= product ? '/admin/products/'+product._id : '/admin/products' %>" method="POST" class="form-grid">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(product){ %><input type="hidden" name="version" value="<%= product.updatedAt.toISOString() %>"><% } %>
<% [["name","Product name",150],["slug","URL slug",120],["brand","Brand",100]].forEach(([key,label,max])=>{ %><label><%= label %><input name="<%= key %>" maxlength="<%= max %>" value="<%= product ? product[key] : '' %>" required></label><% }) %>
<label>Category<select name="category" required><% categories.forEach(category=>{ %><option <%= product && product.category===category?'selected':'' %>><%= category %></option><% }) %></select></label>
<label>Price (NPR)<input type="number" name="price" min="0.01" max="1000000" step="0.01" value="<%= product ? product.price : '' %>" required></label><label>Stock quantity<input type="number" name="stock" min="0" max="1000000" step="1" value="<%= product ? product.stock : 0 %>" required></label>
<label class="wide">Compatible models (comma separated)<input name="compatibleModels" maxlength="2000" value="<%= product ? product.compatibleModels.join(', ') : '' %>"></label>
<label class="wide">Image path or HTTPS URL<input name="image" maxlength="1000" value="<%= product ? product.image : '/images/placeholder-part.svg' %>" required><small>For repository images, use /images/products/filename.jpg. External URLs must be public HTTPS images.</small></label>
<label class="wide">Description<textarea name="description" rows="6" maxlength="5000"><%= product ? product.description : '' %></textarea></label><div class="wide"><button>Save product</button></div></form></section>
<% if(product){ %><section class="panel"><h2>Availability</h2><p class="muted">Archiving removes the product from shopping and recommendations while preserving order history.</p><form action="/admin/products/<%= product._id %>/archive" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= product.updatedAt.toISOString() %>"><input type="hidden" name="active" value="<%= product.active===false?'true':'false' %>"><button class="secondary"><%= product.active===false?'Restore product':'Archive product' %></button></form></section><% } %><%- include("footer") %>
