<%- include("header") %><div class="heading"><div><p class="eyebrow">DELIVERY NETWORK</p><h1>Shipping partners</h1><p class="muted">Contact details used for order-specific delivery notices.</p></div></div>
<% [...rows,null].forEach(partner=>{ %><section class="panel"><h2><%= partner ? partner.name : 'Add shipping partner' %></h2><form method="POST" action="/admin/partners" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(partner){ %><input type="hidden" name="id" value="<%= partner._id %>"><input type="hidden" name="version" value="<%= partner.updatedAt.toISOString() %>"><% } %>
<label>Company name<input name="name" maxlength="100" value="<%= partner ? partner.name : '' %>" required></label><label>Contact person<input name="contactName" maxlength="100" value="<%= partner ? partner.contactName : '' %>"></label><label>Email<input type="email" name="email" maxlength="200" value="<%= partner ? partner.email : '' %>"></label><label>WhatsApp number<input name="whatsapp" maxlength="20" placeholder="+97798XXXXXXXX" value="<%= partner ? partner.whatsapp : '' %>"></label><label class="check"><input type="checkbox" name="whatsappOptIn" <%= partner && partner.whatsappOptIn?'checked':'' %>>Partner agreed to WhatsApp shipment notices</label><label class="check"><input type="checkbox" name="active" <%= !partner || partner.active?'checked':'' %>>Active partner</label><div class="wide"><button>Save partner</button></div></form></section><% }) %><%- include("footer") %>
