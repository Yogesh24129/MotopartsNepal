<%- include("header") %><div class="heading"><div><p class="eyebrow">SHIPPING COMMUNICATION</p><h1>Notice preview</h1></div><a href="/admin/orders/<%= notice.order %>">← Order</a></div>
<section class="panel"><div class="metric-line"><span>Channel</span><strong><%= notice.channel %></strong></div><div class="metric-line"><span>Recipient</span><strong><%= notice.recipient %></strong></div><div class="metric-line"><span>Status</span><span class="badge"><%= notice.status %></span></div><h2><%= notice.subject %></h2><pre class="message-preview"><%= notice.body %></pre>
<% if(notice.status==='draft'){ %><p class="muted">This submits customer delivery details to the assigned shipping partner. Check the recipient and address first. <%= notice.channel === "whatsapp" ? "Opening WhatsApp fills the chat and message; you send it yourself." : "" %></p><form action="/admin/notices/<%= notice._id %>/send" method="POST" target="<%= notice.channel === 'whatsapp' ? '_blank' : '_self' %>" rel="noopener"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button <%= ready?'':'disabled' %>><%= notice.channel === "whatsapp" ? "Open WhatsApp" : "Send email notice" %></button></form><% if(!ready){ %><p class="notice">Provider setup is required before sending. See the README shipping notification instructions.</p><% } %><% } else if(notice.status==='opened'){ %><p class="notice">WhatsApp draft opened. Press Send in WhatsApp to deliver the message. Sending and delivery are not confirmed by this website.</p><% } else if(notice.status==='accepted'){ %><p class="notice success">Provider accepted this notice. This does not confirm delivery to the recipient.</p><p>Provider reference: <%= notice.providerId %></p><% } else { %><p class="notice"><%= notice.failure || 'Submission is in progress or its result is unknown. Check provider records before creating another notice.' %></p><% } %></section><%- include("footer") %>
