<%- include("header") %>
<div class="heading"><div><p class="eyebrow">STORE PERFORMANCE</p><h1>Overview</h1><p class="muted">Customers, inventory and orders in one place.</p></div><form method="GET"><label>Reporting period <select name="days"><% [7,30,90].forEach(days=> { %><option value="<%= days %>" <%= data.days === days ? 'selected' : '' %>>Last <%= days %> days</option><% }) %></select></label><button>Apply</button></form></div>
<div class="stats">
<% [["Registered users",data.users,"All time"],["Active products",data.products,"Available catalog"],["Total orders",data.orders,"All time"],["New customers",data.newUsers,"Selected period"]].forEach(([label,value,hint])=>{ %><article class="stat"><p><%= label %></p><strong><%= value.toLocaleString() %></strong><small><%= hint %></small></article><% }) %>
</div>
<% const paidCount=data.paid.reduce((sum,row)=>sum+row.count,0); const paidTotal=data.paid.reduce((sum,row)=>sum+row.total,0); %>
<div class="stats">
<% [["Paid order value",npr(paidTotal),"Includes sandbox payments; breakdown below"],["Paid orders",paidCount,"Confirmed in selected period"],["Average paid order",npr(paidCount ? paidTotal/paidCount : 0),"Includes delivery fees"],["Measured visitors",data.visitors,"Measured automatically, retained for 30 days"]].forEach(([label,value,hint])=>{ %><article class="stat"><p><%= label %></p><strong><%= value %></strong><small><%= hint %></small></article><% }) %>
</div>
<div class="columns"><section class="panel"><h2>Paid order value over time</h2><p class="muted">Recorded payment date · Nepal time</p>
<% const maximum=Math.max(1,...data.daily.map(row=>row.total)); if (!data.daily.length) { %><p class="empty">No confirmed payments in this period.</p><% } %>
<div class="chart"><% data.daily.forEach(row=>{ %><div class="chart-row"><span><%= row._id %></span><div class="bar-track"><div class="bar" style="width:<%= Math.max(1,row.total/maximum*100) %>%"></div></div><strong><%= npr(row.total) %></strong></div><% }) %></div>
<table><thead><tr><th>Payment environment</th><th>Orders</th><th>Value</th></tr></thead><tbody><% data.paid.forEach(row=>{ %><tr><td><%= row._id || 'unknown (older orders)' %></td><td><%= row.count %></td><td><%= npr(row.total) %></td></tr><% }) %></tbody></table>
</section><section class="panel"><h2>Traffic & engagement</h2><a href="/admin/marketing">Marketing measurement →</a>
<% [["Page views","PageView"],["Product impressions","ProductImpression"],["Product clicks","ProductClick"],["Checkout starts","InitiateCheckout"],["Promotion impressions","PromotionImpression"],["Promotion clicks","PromotionClick"]].forEach(([label,key])=>{ %><div class="metric-line"><span><%= label %></span><strong><%= data.events[key] || 0 %></strong></div><% }) %>
<p class="muted">Traffic events are measured automatically and expire after 30 days. Orders and customer totals come directly from the store database. Paid orders are the conversion count; visitors and buyers may cover different groups.</p><a href="https://analytics.google.com/" target="_blank" rel="noopener">Open Google Analytics ↗</a><p class="muted">GA4 engagement and bounce rate are available in your configured Google Analytics property.</p></section></div>
<div class="columns"><section class="panel"><h2>Best-selling products</h2><table><thead><tr><th>Product</th><th>Units</th><th>Item value</th></tr></thead><tbody><% data.top.forEach(row=>{ %><tr><td><%= row.name %></td><td><%= row.quantity %></td><td><%= npr(row.total) %></td></tr><% }) %></tbody></table><% if(!data.top.length){ %><p class="empty">Sales will appear after payment confirmation.</p><% } %></section>
<section class="panel"><h2>Inventory needs attention</h2><p class="muted">Five units or fewer</p><% data.lowStock.forEach(row=>{ %><div class="metric-line"><a href="/admin/products/<%= row._id %>"><%= row.name %></a><span class="badge <%= row.stock===0?'warning':'' %>"><%= row.stock %> in stock</span></div><% }) %><% if(!data.lowStock.length){ %><p class="empty">Inventory levels look healthy.</p><% } %></section></div>
<section class="panel"><div class="heading"><h2>Recent orders</h2><a href="/admin/orders">View all orders →</a></div><%- include("order-table",{rows:data.recent}) %></section>
<%- include("footer") %>
