<%- include("header") %><div class="heading"><div><p class="eyebrow">CATALOG MANAGEMENT</p><h1>Products</h1><p class="muted">Maintain prices, stock, images and compatibility.</p></div><a class="button" href="/admin/products/new">Add product</a></div>
<form class="search" method="GET"><input name="q" value="<%= q %>" placeholder="Search product, brand or slug" aria-label="Search products"><button>Search</button></form>
<section class="panel table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Availability</th><th></th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><div class="product-cell"><img src="<%= row.image %>" alt="<%= row.name %>"><div><strong><%= row.name %></strong><small><%= row.brand %></small></div></div></td><td><%= row.category %></td><td><%= npr(row.price) %></td><td><span class="badge <%= row.stock<=5?'warning':'' %>"><%= row.stock %></span></td><td><%= row.active===false?'Archived':'Active' %></td><td><a href="/admin/products/<%= row._id %>">Edit →</a></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p class="empty">No products found.</p><% } %><%- include("pagination") %></section><%- include("footer") %>
