<%- include("header") %><div class="heading"><div><p class="eyebrow">CUSTOMER DIRECTORY</p><h1>Customers</h1><p class="muted">Registered accounts and their access roles.</p></div></div><form class="search" method="GET"><input name="q" value="<%= q %>" placeholder="Search name or email" aria-label="Search customers"><button>Search</button></form>
<section class="panel table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Registered</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= row.name %></td><td><%= row.email %></td><td><span class="badge"><%= row.role || 'customer' %></span></td><td><%= date(row.createdAt) %></td></tr><% }) %></tbody></table><%- include("pagination") %></section><%- include("footer") %>
