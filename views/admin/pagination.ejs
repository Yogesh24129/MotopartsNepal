<div class="pagination"><span><%= count %> records · Page <%= page %> of <%= Math.max(1,Math.ceil(count/20)) %></span><div><% if(page>1){ %><a class="button secondary" href="?page=<%= page-1 %>&q=<%= encodeURIComponent(q) %><%= typeof status!=='undefined' ? '&status='+encodeURIComponent(status) : '' %>">Previous</a><% } %><% if(page*20<count){ %><a class="button secondary" href="?page=<%= page+1 %>&q=<%= encodeURIComponent(q) %><%= typeof status!=='undefined' ? '&status='+encodeURIComponent(status) : '' %>">Next</a><% } %></div></div>
