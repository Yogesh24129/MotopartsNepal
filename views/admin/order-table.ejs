<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Shipment</th><th>Placed</th></tr></thead><tbody><% rows.forEach(row=> { %><tr><td><a href="/admin/orders/<%= row._id %>">#<%= row._id.toString().slice(-6).toUpperCase() %></a></td><td><%= row.customer.fullName %></td><td>NPR <%= row.total.toLocaleString() %></td><td><span class="badge"><%= row.paymentMethod %> · <%= row.paymentStatus %></span><% if(row.paymentEnvironment==='sandbox'){ %><small>Sandbox</small><% } %></td><td><%= row.shippingStatus || 'processing' %></td><td><%= new Date(row.createdAt).toLocaleDateString('en-GB',{timeZone:'Asia/Kathmandu'}) %></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p class="empty">No orders found.</p><% } %>
