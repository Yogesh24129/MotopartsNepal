<%- include("header") %><div class="heading"><div><p class="eyebrow">ACCOUNTABILITY</p><h1>Activity log</h1><p class="muted">The latest 100 administrator actions.</p></div></div><section class="panel table-wrap"><table><thead><tr><th>Time</th><th>Administrator</th><th>Action</th><th>Details</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= date(row.createdAt) %></td><td><%= row.actor ? row.actor.email : 'Database operator' %></td><td><%= row.action %></td><td><%= row.summary %></td></tr><% }) %></tbody></table></section><%- include("footer") %>
