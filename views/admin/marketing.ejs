<%- include('header') %>
<section class="panel">
  <div class="marketing-dashboard-heading">
    <div><div class="eyebrow">Marketing measurement</div><h1>From a first look to a paid order.</h1>
      <p>Automatic website measurement across all visitors · last 30 days.</p></div>
    <span class="marketing-mode"><%= marketing.pixelId ? 'Meta Pixel configured' : 'Local measurement' %></span>
  </div>
<p>Measurement is <%= measurement.enabled ? "on" : "disabled in server configuration" %>. Local events are retained for 30 days.</p>
  <div class="stats">
    <article class="stat"><span>Website impressions</span><strong><%= metrics.impressions %></strong><p>Product cards and store promotion seen.</p></article>
    <article class="stat"><span>Clicks</span><strong><%= metrics.clicks %></strong><p>Product links and promotion clicks.</p></article>
    <article class="stat"><span>Conversions</span><strong><%= metrics.conversions %></strong><p>Confirmed paid orders, counted once.</p></article>
    <article class="stat"><span>Order value</span><strong>Rs. <%= metrics.revenue.toLocaleString('en-IN') %></strong><p>Paid order totals attributed to measured visits, including sandbox transactions.</p></article>
  </div>
  <div class="marketing-rates">
    <p><strong>Click-through rate: <%= metrics.ctr.toFixed(1) %>%</strong><br>Clicks ÷ website impressions × 100.</p>
    <p><strong>Checkout conversion rate: <%= metrics.conversionRate.toFixed(1) %>%</strong><br>Paid orders ÷ checkout page views × 100.</p>
  </div>
  <p class="marketing-note">These are website activity, not paid-ad delivery statistics or a Meta delivery receipt.
    Repeated clicks and visits can affect the ratios. Reporting is restricted to administrators.</p>
  <p><a href="/admin/marketing">Refresh results</a></p>
  <h2>Event totals</h2>
  <div class="marketing-table-wrap"><table class="data-table">
    <thead><tr><th>Event</th><th>Count</th><th>Meaning</th></tr></thead>
    <tbody>
      <% const definitions = { PageView: 'A measured store page opened', ProductImpression: 'At least 50% of a product card visible, once per page', PromotionImpression: 'At least 50% of the store promotion visible, once per page', ProductClick: 'A product link clicked', PromotionClick: 'The store promotion clicked', ViewContent: 'A product detail page opened', InitiateCheckout: 'The checkout page opened' }; %>
      <% Object.entries(definitions).forEach(function([name, description]) { %><tr><td><%= name %></td><td><%= metrics.counts[name] || 0 %></td><td><%= description %></td></tr><% }) %>
      <tr><td>Purchase</td><td><%= metrics.conversions %></td><td>Server-confirmed paid order; refreshes and callback retries do not add conversions</td></tr>
    </tbody>
  </table></div>
  <h2>Recent events</h2>
  <% if (!metrics.recent.length) { %><div class="marketing-notice">No events yet. Store visits, product clicks and confirmed paid orders will appear here automatically.</div>
  <% } else { %>
    <div class="marketing-table-wrap"><table class="data-table">
      <thead><tr><th>Time</th><th>Event</th><th>Target / value</th></tr></thead><tbody>
        <% metrics.recent.forEach(function(event) { %>
          <tr><td><%= new Date(event.createdAt).toLocaleString('en-GB', { timeZone: 'Asia/Kathmandu' }) %> NPT</td><td><%= event.type %></td>
            <td><%= event.type === 'Purchase' ? 'Rs. ' + event.value + (event.paymentMethod === 'esewa' ? ' · eSewa' : event.paymentMethod === 'cod' ? ' · cash on delivery' : ' · card') : event.targetId || event.page %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>
<%- include('footer') %>
